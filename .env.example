# 로컬: cp .env.example .env 후 `uv run --env-file .env manage.py runserver`
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=awesome_school
DB_USER=postgres
DB_PASSWORD=postgres

# 비워 두면 메일은 콘솔에 출력된다. Gmail: 2단계 인증 계정의 앱 비밀번호
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Google Sheets 내보내기: 서비스 계정 JSON 경로, 서비스 계정 이메일에 공유한 시트 ID
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
