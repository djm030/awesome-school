# 로컬에서는 이 파일을 .env로 복사한 뒤 `uv run --env-file .env python manage.py runserver`로 실행한다.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=awesome_school
DB_USER=postgres
DB_PASSWORD=postgres

# 비워 두면 메일을 콘솔에 출력한다. Gmail은 2단계 인증을 켠 계정에서 만든 앱 비밀번호를 쓴다.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Google 시트 내보내기에 쓰는 서비스 계정 JSON 경로와 시트 ID. 시트는 서비스 계정 이메일에 편집자로 공유한다.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
